generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnrollmentStatus {
  PENDENTE
  CONFIRMADA
  CANCELADA

  @@map("StatusInscricao")
}

enum PaymentStatus {
  ISENTO
  PENDENTE
  PAGO

  @@map("StatusPagamento")
}

model User {
  id            String   @id @default(uuid())
  name          String   @map("nome")
  email         String   @unique
  passwordHash  String   @map("senha_hash")
  createdAt     DateTime @default(now()) @map("criado_em")
  updatedAt     DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

model Workshop {
  id           String       @id @default(uuid())
  title        String       @map("titulo")
  category     String       @default("Outros") @map("categoria")
  description  String       @map("descricao")
  imageUrl     String?      @map("imagem_url")
  materials    String[]     @default([]) @map("materiais")
  active       Boolean      @default(true) @map("ativa")
  createdAt    DateTime     @default(now()) @map("criado_em")
  updatedAt    DateTime     @updatedAt @map("atualizado_em")
  classes      WorkshopClass[]

  @@index([active])
  @@map("oficinas")
}

model WorkshopClass {
  id          String         @id @default(uuid())
  workshopId  String         @map("oficina_id")
  workshop    Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  name        String         @map("nome")
  capacity    Int            @map("vagas")
  price       Decimal        @default(0) @db.Decimal(10, 2) @map("valor")
  active      Boolean        @default(true) @map("ativa")
  createdAt   DateTime       @default(now()) @map("criado_em")
  updatedAt   DateTime       @updatedAt @map("atualizado_em")
  meetings    ClassMeeting[]
  enrollments Enrollment[]

  @@index([workshopId, active])
  @@map("turmas")
}

model ClassMeeting {
  id        String        @id @default(uuid())
  classId   String        @map("turma_id")
  class     WorkshopClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt  DateTime      @map("data_inicio")
  endsAt    DateTime      @map("data_fim")
  location  String        @map("local")
  createdAt DateTime      @default(now()) @map("criado_em")
  updatedAt DateTime      @updatedAt @map("atualizado_em")

  @@index([classId, startsAt])
  @@map("encontros_turma")
}

model Enrollment {
  id           String           @id @default(uuid())
  name         String           @map("nome")
  email        String
  status       EnrollmentStatus @default(PENDENTE)
  paymentStatus PaymentStatus   @default(ISENTO) @map("status_pagamento")
  paymentTokenHash String?       @unique @map("token_pagamento_hash")
  paidAt       DateTime?         @map("pago_em")
  cancellationTokenHash String? @unique @map("token_cancelamento_hash")
  classId      String           @map("turma_id")
  class        WorkshopClass    @relation(fields: [classId], references: [id])
  createdAt    DateTime         @default(now()) @map("criado_em")
  updatedAt    DateTime         @updatedAt @map("atualizado_em")

  @@unique([email, classId])
  @@index([status, createdAt])
  @@map("inscricoes")
}
